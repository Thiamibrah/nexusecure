# Application
APP_NAME=NexusSecure
APP_ENV=development
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./nexussecure.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nexussecure

# Postgres (docker-compose only — used to build the api service's DATABASE_URL and to
# configure the db service; POSTGRES_PASSWORD has no default, docker compose refuses to
# start without it set here)
POSTGRES_DB=nexussecure
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_RANDOM_VALUE

# Admin
FIRST_ADMIN_EMAIL=admin@nexussecure.local
# Leave unset to auto-generate a random password at first startup (logged once).
# Set explicitly only if you need a known password; it still must be changed on first login.
FIRST_ADMIN_PASSWORD=

# Logs — relative to the app's own CWD when run (backend/), not to .env's location.
LOG_LEVEL=INFO
LOG_FILE=app/logs/nexussecure.log
